# 카카오 디벨로퍼스 REST API 키 (로컬 npm run server / Edge Function 시크릿)
# https://developers.kakao.com → 앱 키 → REST API 키 · Daum 검색 활성화
KAKAO_REST_API_KEY=

# 선택: 프론트에서 표지 프록시 origin을 고정할 때(빌드 시)
# VITE_API_BASE=http://localhost:8787

# Supabase (함께 있기 Realtime + 카카오 Edge Function)
# 대시보드 → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# publishable 키 권장. 없으면 기존 anon 키도 동작
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
